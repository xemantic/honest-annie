# The settings of honest-annie in FrontierHarness Eval, see host/Main.kt and README.md.
# They are frozen into the golden checkpoint with the harness, so changing them takes a new checkpoint and run id.

# A guard against a runaway tree of cogitations rather than a limit any task should reach:
# the baselines spend about 1M tokens per task, but an endpoint reporting no cached input counts the whole context
# at every step, so 20M ended a DeepSWE task of DeepSeek V4.1 Flash before it committed its work.
ANNIE_TOKEN_BUDGET=60000000

# The model's own default effort, like the baselines, when not set,
# but for Claude Fable, which local.sh runs at medium, see there.
#ANNIE_EFFORT=high

# Claude caches for 5 minutes when not set; 1h pays off only when tasks of the same constitution
# start 5 to 60 minutes apart, its write costing 2 times the input instead of 1.25.
#ANNIE_CACHE_TTL=1h

# Claude infers a step after a refused one by claude-opus-5-5 when not set, by the same model when none.
#ANNIE_FALLBACK_MODEL=none

# Unset, the invoked cogitations step in parallel with no limit.
#ANNIE_PARALLELISM=4

# The bundled Java runtime takes a quarter of the memory of the container by default.
JAVA_OPTS=-XX:MaxRAMPercentage=50
