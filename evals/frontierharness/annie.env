# The settings of honest-annie in FrontierHarness Eval, see host/Main.kt and README.md.
# They are frozen into the golden checkpoint with the harness, so changing them takes a new checkpoint and run id.

# A guard against a runaway tree of cogitations rather than a limit any task should reach:
# the baselines spend about 1M tokens per task.
ANNIE_TOKEN_BUDGET=20000000

# The model's own default effort, like the baselines, when not set.
#ANNIE_EFFORT=high

# Unset, the invoked cogitations step in parallel with no limit.
#ANNIE_PARALLELISM=4

# The bundled Java runtime takes a quarter of the memory of the container by default.
JAVA_OPTS=-XX:MaxRAMPercentage=50
